<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <div class="max-w-4xl mx-auto pt-20 px-6">
    <div class="bg-white rounded-3xl shadow-xl p-10 text-center">
      <h1 class="text-5xl font-bold text-gray-800 mb-4">Welcome to My App</h1>
      
      <% if (user) { %>
        <p class="text-xl text-gray-600 mb-8">Hello, <span class="font-semibold text-blue-600"><%= user.username %></span> 👋</p>
        <a href="/logout" 
           class="inline-block bg-red-500 hover:bg-red-600 text-white px-8 py-3 rounded-xl font-medium transition">
          Logout
        </a>
      <% } else { %>
        <div class="space-x-4">
          <a href="/login" class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-xl font-medium transition">
            Login
          </a>
          <a href="/register" class="inline-block bg-gray-800 hover:bg-gray-900 text-white px-8 py-3 rounded-xl font-medium transition">
            Register
          </a>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>