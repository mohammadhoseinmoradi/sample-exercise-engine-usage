<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>
  <body class="bg-gray-100 min-h-screen">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <!-- Header -->
      <div class="flex justify-between items-center mb-10 border-b-xs">
        <div>
          <h1 class="text-4xl font-bold text-gray-800">
            Welcome back,
            <span class="text-blue-600"
              ><%= user ? user.username : 'Guest' %></span
            >!
          </h1>
        </div>
        <a
          href="/logout"
          class="flex items-center gap-2 bg-red-500 hover:bg-red-600 text-white px-5 py-2.5 rounded-xl font-medium transition"
        >
          <i class="fas fa-sign-out-alt"></i>
          Logout
        </a>
      </div>

      <!-- Exercises Grid -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
      >
        <!-- Card 1 -->
        <div
          class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition"
        >
          <div class="relative">
            <img
              src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=600"
              alt="Backwards Step And Reach"
              class="w-full h-52 object-cover"
            />
            <div class="absolute top-3 left-3 flex gap-2">
              <span
                class="bg-red-500 text-white text-xs font-medium px-3 py-1 rounded-full"
                >Angular</span
              >
              <span
                class="bg-green-500 text-white text-xs font-medium px-3 py-1 rounded-full"
                >Distance</span
              >
            </div>
          </div>
          <div class="p-5">
            <h3 class="font-semibold text-lg text-gray-800 mb-1">
              Backwards Step And Reach...
            </h3>
            <p class="text-gray-500 text-sm line-clamp-2">
              No description has been recorded for this exercise.
            </p>

            <div class="flex justify-between items-center mt-6">
              <button
                onclick="startExercise(1)"
                class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl text-sm font-medium transition flex items-center gap-2"
              >
                <i class="fas fa-play"></i>
                Start
              </button>
              <div class="flex gap-3 text-gray-400">
                <i class="fas fa-edit hover:text-blue-500 cursor-pointer"></i>
                <i class="fas fa-trash hover:text-red-500 cursor-pointer"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      function startExercise(id) {
        alert(`Starting exercise ${id}... `);
        // window.location.href = `/exercise/${id}`;
      }
    </script>
  </body>
</html>
